<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile/>
  <group name="General">
    <!-- Dimensions -->
    <entry name="compactWidth" type="Int">
      <default>165</default>
    </entry>
    <entry name="compactHeight" type="Int">
      <default>36</default>
    </entry>
    <entry name="expandedWidth" type="Int">
      <default>420</default>
    </entry>
    <entry name="expandedHeight" type="Int">
      <default>325</default>
    </entry>
    <entry name="borderRadius" type="Int">
      <default>18</default>
    </entry>
    <entry name="islandPadding" type="Int">
      <default>12</default>
    </entry>
    <entry name="islandShapeMode" type="String">
      <default>notch</default>
    </entry>
    <entry name="notchStyle" type="Int">
      <default>0</default>
    </entry>
    <entry name="verticalOffset" type="Int">
      <default>0</default>
    </entry>
    <entry name="horizontalOffset" type="Int">
      <default>0</default>
    </entry>
    <entry name="clockFontSize" type="Int">
      <default>13</default>
    </entry>
    <entry name="notchCornerRadius" type="Int">
      <default>14</default>
    </entry>
    <entry name="notchBottomRadius" type="Int">
      <default>14</default>
    </entry>
    <entry name="notchWingRadius" type="Int">
      <default>14</default>
    </entry>

    <!-- Appearance -->
    <entry name="backgroundColor" type="Color">
      <default>#0d0f12</default>
    </entry>
    <entry name="backgroundOpacity" type="Double">
      <default>0.92</default>
    </entry>
    <entry name="enableBlur" type="Bool">
      <default>true</default>
    </entry>
    <!-- Gaya Background Utama Notch Saat Dibuka: 0 = Solid Black, 1 = Glassy Frosted Blur -->
    <entry name="expandedBgStyle" type="Int">
      <default>0</default>
    </entry>
    <!-- Gaya Background Khusus Tab Media Player: 0 = Pure Dark, 1 = Full Adaptive Tint, 2 = Album Bottom Gradient, 3 = Acrylic Blur / Liquid Glass -->
    <entry name="mediaBgStyle" type="Int">
      <default>2</default>
    </entry>
    <entry name="mediaCardBgMode" type="Int">
      <default>2</default>
    </entry>
    <!-- Gaya Background Khusus Mode Lirik: 0 = Pure Dark Solid, 1 = Bottom Album Tint -->
    <entry name="lyricsBgMode" type="Int">
      <default>1</default>
    </entry>
    <entry name="borderColor" type="Color">
      <default>#33ffffff</default>
    </entry>
    <entry name="accentColor" type="Color">
      <default>#3daee9</default>
    </entry>

    <!-- Interaction -->
    <entry name="expandOnHover" type="Bool">
      <default>false</default>
    </entry>
    <entry name="notificationDuration" type="Int">
      <default>4500</default>
    </entry>

    <!-- Modular Toggles -->
    <entry name="showVisualizer" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showCompactVisualizer" type="Bool">
      <default>false</default>
    </entry>

    <!-- Kustomisasi Ikon Musik Samping Jam -->
    <entry name="miniMusicIconEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="miniMusicIconSize" type="Int">
      <default>13</default>
    </entry>
    <entry name="miniMusicIconWeight" type="Int">
      <default>600</default> <!-- Bobot font (400 = Normal, 700 = Bold) -->
    </entry>
    <entry name="miniMusicIconColorMode" type="Int">
      <default>0</default> <!-- 0: Warna Album (Dynamic), 1: Aksen Sistem KDE, 2: Putih / Abu Redup, 3: Custom Color -->
    </entry>
    <entry name="miniMusicIconCustomColor" type="Color">
      <default>#ffffff</default>
    </entry>

    <!-- Dimensi Mini Visualizer -->
    <entry name="miniVisBarWidth" type="Int">
      <default>2</default>
    </entry>
    <entry name="miniVisHeight" type="Int">
      <default>14</default>
    </entry>
    <entry name="miniVisSpacing" type="Int">
      <default>2</default>
    </entry>

    <!-- Warna Mini Visualizer: 0 = Warna Album (Dynamic), 1 = Aksen Sistem, 2 = Custom Color -->
    <entry name="miniVisColorMode" type="Int">
      <default>0</default>
    </entry>
    <entry name="miniVisCustomColor" type="Color">
      <default>#38bdf8</default>
    </entry>

    <!-- Opsi Arah & Bentuk Mini Visualizer: 0 = Bottom-Aligned, 1 = Center-Aligned / Mirrored -->
    <entry name="miniVisAlignment" type="Int">
      <default>1</default>
    </entry>
    <entry name="miniVisMaxHeight" type="Int">
      <default>14</default>
    </entry>
    <entry name="miniVisRounded" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showControlTab" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showMediaTab" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showClipboardTab" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showNotificationTab" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showCalendarTab" type="Bool">
      <default>true</default>
    </entry>
    <entry name="calendarFirstDayOfWeek" type="Int">
      <default>1</default>
    </entry>

    <!-- Typography Customization -->
    <entry name="clockFontFamily" type="String">
      <default></default>
    </entry>
    <entry name="clockFontBold" type="Bool">
      <default>true</default>
    </entry>
    <entry name="lyricsFontFamily" type="String">
      <default></default>
    </entry>
    <entry name="lyricsFontSize" type="Int">
      <default>13</default>
    </entry>
    <entry name="lyricsFontBold" type="Bool">
      <default>true</default>
    </entry>
    <entry name="autoRetryLyrics" type="Bool">
      <default>true</default>
    </entry>
  </group>
</kcfg>
